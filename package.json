    "ingest:approved-pages": "node --env-file=.env.local scripts/ingest-approved-page-index.mjs",
    "evaluate:retrieval": "node --env-file=.env.local scripts/evaluate-retrieval.mjs",
    "evaluate:forum-workflow": "node --env-file=.env.local scripts/evaluate-forum-workflow.mjs",
