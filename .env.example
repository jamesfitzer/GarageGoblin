# Local-only secret. Copy this file to .env.local and add a dedicated OpenAI API project key.
OPENAI_API_KEY=
OPENAI_PRODUCTION_API_KEY=

# Created by the ingestion script after the approved initial source set is indexed.
OPENAI_VECTOR_STORE_ID=
OPENAI_PAGE_INDEX_VECTOR_STORE_ID=
OPENAI_FULL_PAGE_INDEX_VECTOR_STORE_ID=

# Hosted-demo phase only. Never commit populated values; add them to .env.local
# for local development and to the matching Vercel environment for deployment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
GARAGE_GOBLIN_UNLIMITED_EMAIL=
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
